# R3PLAYX frontend (React web + nginx) image
FROM node:22-alpine AS build

ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@8.6.12 --activate
RUN pnpm config set registry https://registry.npmmirror.com

WORKDIR /repo

# Manifests first for better layer caching (server/desktop manifests only keep
# pnpm workspace resolution happy; they are filtered out of the install)
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/web/package.json packages/web/
COPY packages/server/package.json packages/server/
COPY packages/desktop/package.json packages/desktop/
# --ignore-scripts: the root `install` lifecycle script (turbo run
# post-install) would fail here — turbo is not installed under a filtered
# install. The web app has no native builds to skip.
RUN pnpm install --frozen-lockfile=false --filter web --ignore-scripts

# Web sources + shared sources (imported through the '@' -> packages/ alias)
COPY packages/shared packages/shared
COPY packages/web packages/web

ENV VITE_APP_NETEASE_API_URL=/netease
RUN pnpm --filter web run build

FROM nginx:1.27-alpine

COPY docker/nginx.conf.example /etc/nginx/conf.d/default.conf
COPY --from=build /repo/packages/web/dist /usr/share/nginx/html

EXPOSE 80
